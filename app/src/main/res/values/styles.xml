<resources>
    <style name="MetroBaseTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#39B9D4</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="MetroTheme" parent="MetroBaseTheme"/>
    <style name="SheetMotion">
        <item name="android:windowEnterAnimation">@anim/scrim_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>
</resources>
